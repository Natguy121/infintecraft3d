rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // public profile (name, discoveries, level) used by the leaderboard
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // each player's save: only they can read or write it
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // public multiplayer rooms: anyone can list them, a logged-in host manages their own
    match /rooms/{code} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // worldwide first discoverers: anyone can read, a player can claim an unclaimed item once
    match /firsts/{item} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
